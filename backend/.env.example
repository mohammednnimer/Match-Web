# Copy to .env and fill in your real values.

# --- PostgreSQL -------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=matchsystems
PGUSER=postgres
PGPASSWORD=change-me

# --- API --------------------------------------------------------------------
API_PORT=8000
API_PREFIX=/v1

# Comma-separated origins allowed to call the API from a browser.
# Add whatever port serves the .dc.html pages.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://localhost:3000

# --- Auth -------------------------------------------------------------------
# Writes require a valid Bearer token signed with JWT_SECRET. Set to false only
# for local debugging; public GET requests from the landing pages are unaffected.
AUTH_REQUIRED=true
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Fallback actor name written to the audit log when AUTH_REQUIRED=false.
# Login credentials live in the users table -- create one with create_admin.py.
ADMIN_EMAIL=admin@matchsystems.com

# --- Startup ----------------------------------------------------------------
# Run db/schema.sql automatically when the API boots. No records are ever seeded.
AUTO_MIGRATE=true
